{
  "expo": {
    "name": "Vado",
    "slug": "vado",
    "scheme": "vado",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F7EC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vado.prototipo"
    },
    "android": {
      "package": "app.vado.prototipo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_DISTANCE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Vado usa la posizione durante un tragitto per misurare la distanza percorsa."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Vado usa i dati di movimento per contare i passi durante un tragitto."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#C8F560"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Oggi",
              "label": "Vado, oggi",
              "description": "Punti di oggi, CO₂ evitata e il pulsante Parti",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ]
  }
}

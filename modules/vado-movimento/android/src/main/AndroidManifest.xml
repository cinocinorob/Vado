<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Riconoscere se si cammina, si pedala o si è su un mezzo. -->
  <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <receiver android:name="app.vado.movimento.TransitionReceiver" android:exported="false" />
    <!-- BOOT_COMPLETED e MY_PACKAGE_REPLACED li manda solo il sistema; il ricevitore riattiva il riconoscimento se era acceso. -->
    <receiver android:name="app.vado.movimento.BootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
